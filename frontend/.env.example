# Optional: only if you do NOT use ../backend/.env
# Vite maps AI_MANAGER_SUPABASE_URL → VITE_SUPABASE_URL and
# AI_MANAGER_SUPABASE_ANON_KEY → VITE_SUPABASE_ANON_KEY from backend/.env automatically.
# Restart `npm run dev` after changing either file.

VITE_SUPABASE_URL=https://your-ai-manager-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-ai-manager-anon-key

# Vercel Services: set to backend routePrefix from vercel.json (e.g. /_/backend). Omit locally.
# VITE_API_PATH_PREFIX=/_/backend

# Local dev: skip Google OAuth and authenticate with an API key instead.
# Create a key in AI Admin → Settings → API keys, then paste the aim_sk_… value here
# (or in backend/.env — Vite forwards it automatically).
# Leave blank or remove to use normal Google sign-in.
# VITE_DEV_API_KEY=aim_sk_...
