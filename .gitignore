# Dependencies
node_modules/

# Environment (never commit secrets)
.env
.env.*
!.env.example
!.env.replica.example
!.env.old.example
# Public-by-design build config for the iOS shell (absolute API base + publishable Supabase
# key — the same values every web bundle ships). No secrets may ever be added to it.
!apps/cadence-web/.env.ios
backend/.env.replica
backend/.env.old

# Database dumps (may contain production data)
backups/

# Build output
dist/
build/
*.tsbuildinfo

# Test / coverage
coverage/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# Vite
frontend/dist/

# Puppeteer / Chromium cache
.cache/

# Vitest
**/.vite/

# Local screenshots from widget health checks
**/screenshots/

# Husky's own auto-generated internal shims (not actual hooks - see .husky/pre-commit)
.husky/_
