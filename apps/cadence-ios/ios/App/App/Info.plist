<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Cadence</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Export compliance. Cadence uses only HTTPS/TLS through the OS, which Apple exempts, so
	     there is nothing to declare. Answering it HERE rather than in App Store Connect matters
	     operationally: without this key every single upload lands flagged "Missing Compliance"
	     and is NOT installable by testers until someone answers the same questionnaire by hand in
	     the web UI — a manual gate between every build and the people waiting for it. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>builders.cadence.app.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cadence</string>
			</array>
		</dict>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>Cadence reads your workouts from Apple Health so what you did can count — you pick each one before it's logged, and nothing is shared without you.</string>
	<key>NSCameraUsageDescription</key>
	<string>Cadence uses the camera when you snap a meal, a nutrition label, or a barcode — only when you tap to open it, and you see the photo before anything counts.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Cadence doesn't write to Apple Health today. If that ever changes, it will only save what you asked it to.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Cadence uses your rough location for local weather and to notice when you're traveling, so the plan can bend with you. It's checked while you have the app open, never followed in the background.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Cadence uses the microphone when you tap the mic, so you can talk to your coach instead of typing. It only listens while you have it on, and you see what it heard before anything is sent.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your speech is turned into text so you can talk to your coach instead of typing. The words land in the message box for you to read and edit — nothing is sent until you send it.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Required alongside the Communication Notifications entitlement: an app that donates
	     INSendMessageIntent must declare it here, or the donation/updating(from:) call is refused. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- Portrait only. The UI is a phone-shaped chat and there is no landscape design: the CSS
	     that makes the app full-bleed is behind `@media (max-width: 480px)`, which cannot match at
	     a ~852pt landscape width, so rotating fell back to the DESKTOP mockup — a clipped 390x760
	     fake phone complete with a second, fake status bar. Locking the orientation removes the
	     broken layout rather than building one nobody designed. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- TARGETED_DEVICE_FAMILY is "1,2", so this installs on iPad and the ~ipad array is live.
	     Upside-down is normal on iPad; it is not on a Face ID iPhone, which is why it is only here. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
