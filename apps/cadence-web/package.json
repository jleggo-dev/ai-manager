{
  "name": "@cadence/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cadence PWA (React + Vite). Wrapped in Capacitor for iOS later; native calls go through the capability seam.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
