# Cadence API — environment
# Copy to .env and fill in. .env is gitignored — never put real secrets in THIS file.
#
# AI Admin engine secrets are NOT set here — they load from backend/.env (single
# source of truth), since cadence-api consumes the AI Admin engine in-process.

# ── Cadence server ───────────────────────────────────────────────
CADENCE_API_PORT=3101
NODE_ENV=development

# ── Dev/test accounts (coexist with real auth) ───────────────────
# When set, the header-based dev accounts are available (web app sends the header only at ?dev=1).
# Real Supabase auth still works alongside it locally. LEAVE UNSET IN PRODUCTION so no dev-account
# bypass ships — with it unset, every request must present a valid Supabase JWT.
CADENCE_DEV_USER_ID=00000000-0000-4000-a000-000000000001
# Post-merge scratch cleanup (dev only): from repo root —
#   npm run cleanup:cadence-dev-accounts
#   # or: node --import tsx apps/cadence-api/scripts/account.ts reset-all
# Also resets via in-app /dev/reset when CADENCE_DEV_USER_ID is set.

# ── Cadence Supabase (REUSES the Spartan Tracker project — Cadence supersedes it) ─
# Tables live in the `cadence` schema; public.tracker_data is left untouched.
CADENCE_SUPABASE_URL=https://qvukqinwmyvewzgcsgzt.supabase.co
CADENCE_SUPABASE_ANON_KEY=sb_publishable_kg7r2W6xVdRMPSlVFww1aw_4vE1ZS-H
# Service role (secret) key — get from Supabase dashboard → Project Settings → API.
CADENCE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Direct Postgres (Supabase pooler) — app data via the `cadence` schema ─
# Simplest: paste ONLY the DB password (Supabase → Settings → Database).
# Host/user/port/db are built in config.ts (overridable via CADENCE_DB_HOST/USER/PORT/NAME).
CADENCE_DB_PASSWORD=your-db-password
# Optional full override (must include @host); leave blank to use CADENCE_DB_PASSWORD:
CADENCE_DATABASE_URL=

# ── AI Admin: which workspace/profiles/jobs Cadence uses ──────────
# Cadence acts as a trusted server scoped to this AI Admin workspace.
AIM_WORKSPACE_ID=
AI_ADMIN_CALLING_APP=platform:cadence
AIM_COACH_PROFILE_ID=
AIM_BROKER_PROFILE_ID=
AIM_WORKFLOW_REPLAN_SLUG=cadence-replan
# (The AIM_JOB_*_ID vars were removed 2026-08-04 — every job resolves by slug through
#  runJobBySlug. They were still listed here long after nothing read them; a stale example
#  file is how a dead var gets faithfully copied into Vercel and CI forever.)
# Nutrition / food-capture jobs (parse-meal, plate-advice, parse-nutrition-label,
# identify-food, estimate-food) resolve by slug via runJobBySlug — no AIM_JOB_* ids.
# Sync live after config changes: node --import tsx apps/cadence-api/scripts/sync-jobs.ts

# AI Admin engine secrets (AI_MANAGER_SUPABASE_*, CREDENTIAL_ENCRYPTION_KEY,
# DEVS_AI_*) are read from backend/.env — do NOT duplicate them here.

# ── Cadence-owned integrations ────────────────────────────────────
# OpenWeatherMap (api.openweathermap.org) — server-only current + short forecast
# for outdoor exercise context, coach date/weather injection, and extreme_weather
# tripwires. Never put this in VITE_* or cadence-web (read as cadenceConfig.weatherApiKey).
# Free key: https://openweathermap.org/api — also set WEATHER_API_KEY on the
# cadence-api Vercel project env (not the web project). Never log the key.
# Still required after WeatherKit: it is the FALLBACK provider, and the only geocoder
# (WeatherKit has no city -> lat/lon endpoint).
WEATHER_API_KEY=
# Apple WeatherKit (REST) — PREFERRED weather source when set, so an iOS user's Cadence
# forecast matches their lock screen. Unset = WeatherKit off, OpenWeatherMap used as before.
# Apple Developer portal, three separate objects:
#   1. Keys -> new key with WeatherKit enabled -> .p8 download (once) + Key ID
#   2. Identifiers -> App IDs -> your bundle id, WeatherKit capability enabled
#   3. Identifiers -> Services IDs -> new -> its identifier is WEATHERKIT_SERVICE_ID
# WEATHERKIT_SERVICE_ID is the SERVICES ID, not the bundle id — the most common 401 cause.
# WEATHERKIT_TEAM_ID is the 10-char team id. WEATHERKIT_PRIVATE_KEY is the .p8 PEM contents
# (literal \n escapes are fine). All server-only; never VITE_*.
WEATHERKIT_KEY_ID=
WEATHERKIT_TEAM_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_PRIVATE_KEY=
# Sign in with Apple — a SEPARATE key and a SEPARATE Services ID from WeatherKit above
# (reusing either is the usual cause of a Supabase audience-mismatch error).
#   1. Keys -> new key with "Sign in with Apple" enabled -> .p8 + Key ID
#   2. Identifiers -> App IDs -> your bundle id -> tick "Sign in with Apple"
#   3. Identifiers -> Services IDs -> + -> tick "Sign in with Apple" -> Configure:
#      domain = <project>.supabase.co, return URL = https://<project>.supabase.co/auth/v1/callback
# Used ONLY by scripts/generate-apple-secret.ts to mint the Supabase client secret; the API
# itself never reads these at runtime (Supabase does the OAuth).
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_SERVICE_ID=
APPLE_SIGNIN_PRIVATE_KEY=
# USDA FoodData Central (api.data.gov) — server-only for whole-food lookup.
# Never put this in VITE_* or cadence-web. Free key: https://api.data.gov/signup/
# Also set on the cadence-api Vercel project env (not the web project).
USDA_API_KEY=

# FatSecret Platform API — server-only, for BRANDED and restaurant foods (A23 §4). USDA's
# Foundation/SR Legacy datasets structurally cannot hold a convenience-store snack, and Open Food
# Facts only answers to a barcode, so a photographed pack has no deterministic source without this.
#
# OAUTH 1.0, DELIBERATELY. Their OAuth 2.0 flow requires whitelisting the caller's IP, and this API
# runs on Vercel serverless — dynamic egress, no fixed address to register. OAuth 1.0 signs each
# request with the consumer secret instead, so it needs no allowlist and works from anywhere.
# Never put these in VITE_* or cadence-web; set them on the cadence-api Vercel project too.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=

# ── APNs push (native iOS shell) ──────────────────────────────────
# Token-based auth: Apple Developer portal → Keys → new key with APNs enabled.
# APNS_PRIVATE_KEY is the .p8 file's PEM contents (literal \n escapes are fine locally;
# on Vercel paste the file as-is, multi-line and UNQUOTED — quotes break the PEM decoder).
# All server-only; unset = push disabled (apnsConfigured() gates every send).
#
# APNS_KEY_ID and APNS_ENVIRONMENT ARE A MATCHED PAIR. Apple issues environment-SCOPED APNs
# keys: a Sandbox key is rejected by the production host and vice versa, both with
# `403 BadEnvironmentKeyInToken` (verified 2026-08-07 against both hosts). A mismatch is
# therefore a hard failure, not a fallback.
#   development -> api.sandbox.push.apple.com -> the SANDBOX key  (Xcode/dev builds)
#   production  -> api.push.apple.com         -> the PRODUCTION key (TestFlight/App Store)
# Which build a device token came from decides which pair you need. A Debug-signed build's
# token exists ONLY in sandbox, so prod-configured servers cannot reach your own dev phone.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=builders.cadence.app
APNS_ENVIRONMENT=development

# ── CORS (native iOS shell) ───────────────────────────────────────
# Extra allowed origins, comma-separated. capacitor://localhost, https://localhost,
# and http://localhost:3100 are always allowed (see src/lib/cors.ts).
CADENCE_CORS_ORIGINS=
