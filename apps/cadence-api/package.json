{
  "name": "@cadence/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cadence Node backend. Owns Cadence's Supabase DB + deterministic engines; consumes AI Admin in-process via @ai-admin/core.",
  "scripts": {
    "dev": "node --import tsx --watch-path=src src/index.ts",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "account": "node --import tsx scripts/account.ts",
    "cleanup:dev-accounts": "node --import tsx scripts/account.ts reset-all",
    "probe:backgrounded": "node --import tsx scripts/probe-backgrounded-phone.ts",
    "probe:replan": "node --import tsx scripts/probe-replan-preview.ts",
    "eval:tools": "node --import tsx scripts/eval-tool-selection.ts",
    "eval:outcomes": "node --import tsx scripts/eval-outcomes.ts",
    "metrics:food-ledger": "node --import tsx scripts/food-variance-baseline.ts",
    "eval:food-vision": "node --import tsx scripts/eval-food-vision.ts",
    "smoke:food-sources": "tsx scripts/smoke-food-sources.ts",
    "capture:food-fixtures": "tsx scripts/capture-food-fixtures.ts",
    "import:cnf": "tsx scripts/import-cnf.ts"
  },
  "dependencies": {
    "@ai-admin/core": "*",
    "@cadence/shared": "*",
    "@supabase/supabase-js": "^2",
    "@vercel/functions": "^3.9.5",
    "dotenv": "^16",
    "express": "^4",
    "postgres": "^3.4.5",
    "tsx": "^4.21.0",
    "undici": "^7.28.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^9.39.5",
    "globals": "^17.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
