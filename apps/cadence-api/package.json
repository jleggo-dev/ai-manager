{
  "name": "@cadence/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cadence Node backend. Owns Cadence's Supabase DB + deterministic engines; consumes AI Admin in-process via @ai-admin/core.",
  "scripts": {
    "dev": "node --import tsx --watch-path=src src/index.ts",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-admin/core": "*",
    "@cadence/shared": "*",
    "@supabase/supabase-js": "^2",
    "dotenv": "^16",
    "express": "^4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
