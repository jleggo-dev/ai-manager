{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["pdx1"],
  "services": {
    "api": {
      "root": ".",
      "framework": "express",
      "installCommand": "npm install --prefix ../.."
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "api" } }
  ]
}
