{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["pdx1"],
  "services": {
    "api": {
      "root": ".",
      "framework": "express",
      "installCommand": "npm install --prefix ../.."
    }
  },
  "functions": {
    "src/index.ts": {
      "maxDuration": 800
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "api" } }]
}
