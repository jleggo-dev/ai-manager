{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["pdx1"],
  "services": {
    "api": {
      "root": ".",
      "framework": "express",
      "installCommand": "npm install --prefix ../..",
      "functions": { "**": { "maxDuration": "max" } }
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "api" } }]
}
