{
  "version": 2,
  "regions": ["sfo1"],
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/_/backend",
      "maxDuration": 800
    }
  },
  "crons": [
    {
      "path": "/_/backend/api/cron/tick/health",
      "schedule": "0 0 * * *"
    }
  ]
}
