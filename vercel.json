{
  "version": 2,
  "regions": ["sfo1"],
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "framework": "express",
      "functions": {
        "**": { "maxDuration": 800 }
      }
    }
  },
  "rewrites": [
    { "source": "/_/backend/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
