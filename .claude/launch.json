{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cadence-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "apps/cadence-web"
      ],
      "port": 3100
    },
    {
      "name": "cadence-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "apps/cadence-api"
      ],
      "port": 3101
    },
    {
      "name": "cadence-ios-bundle",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "cwd": "apps/cadence-web",
      "port": 4173
    }
  ]
}