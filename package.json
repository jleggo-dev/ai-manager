{
  "name": "ai-admin",
  "private": true,
  "version": "1.4.0",
  "workspaces": [
    "backend",
    "frontend",
    "packages/types",
    "packages/client",
    "packages/edge",
    "packages/core",
    "packages/cadence-shared",
    "apps/cadence-api",
    "apps/cadence-web"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=backend",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "vercel:build:frontend": "npm run lint --workspace=frontend && npm run build --workspace=frontend",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"{backend,frontend,packages/core,packages/cadence-shared,apps/cadence-api,apps/cadence-web}/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{backend,frontend,packages/core,packages/cadence-shared,apps/cadence-api,apps/cadence-web}/src/**/*.{ts,tsx}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrate:supabase-data": "npm run migrate:data --workspace=backend",
    "test:e2e": "npx vitest run --config e2e/vitest.config.ts",
    "test:e2e:full": "bash scripts/run-e2e.sh",
    "cleanup:cadence-dev-accounts": "node --import tsx apps/cadence-api/scripts/account.ts reset-all",
    "cleanup:e2e-ai-admin": "npx tsx backend/scripts/cleanup-e2e-test-data.ts --yes",
    "cleanup:test-data": "npm run cleanup:cadence-dev-accounts && npm run cleanup:e2e-ai-admin",
    "ci": "npm run typecheck && npm run format:check && npm run lint && npm test",
    "prepush": "npm run typecheck && npm run format:check && npm run lint && npm run build --workspaces --if-present && npm run vercel:build:frontend && npm test",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "{backend,apps/cadence-api}/{src,test}/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "{frontend,apps/cadence-web}/src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "packages/{core,cadence-shared}/src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.ts?(x)": [
      "bash -c 'npm run typecheck'"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "puppeteer": "^24.40.0"
  }
}
