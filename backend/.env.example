# AI Admin Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to source control.

# Server
PORT=3001
NODE_ENV=development

# Supabase (AI Manager project)
AI_MANAGER_SUPABASE_URL=https://your-project.supabase.co
AI_MANAGER_SUPABASE_ANON_KEY=your-anon-key
AI_MANAGER_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Credential encryption (required in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# Devs.ai (optional — only needed if using Devs.ai as a provider)
DEVS_AI_BASE_URL=https://devs.ai
DEVS_AI_API_KEY=

# Request body size limit (optional, default: 1mb)
# API_JSON_BODY_LIMIT=1mb

# Trust proxy hops (optional, default: 1)
# TRUST_PROXY_HOPS=1

# Vercel Cron Secret (required in production — Vercel auto-injects this)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Dev-only: API key for frontend dev auth bypass (NEVER set in production)
# VITE_DEV_API_KEY=

# Post-merge E2E leftover cleanup (e2e% calling apps/sessions/logs + Lifecycle/E2E-named
# providers, profiles, and jobs — never deletes Devs.ai / Devs.ai v2 / Google Gemini by type):
#   npx tsx backend/scripts/cleanup-e2e-test-data.ts       # dry-run
#   npm run cleanup:e2e-ai-admin                          # apply (--yes)
# Full local post-merge wipe (Cadence scratch accounts + AI Admin e2e leftovers):
#   npm run cleanup:test-data
