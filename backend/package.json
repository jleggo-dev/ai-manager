{
  "name": "ai-admin-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "dev": "node --import tsx --watch-path=src src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:data": "node --import tsx scripts/migrate-supabase-data.mts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0"
  },
  "dependencies": {
    "@sparticuz/chromium": "^148.0.0",
    "@supabase/supabase-js": "^2",
    "dotenv": "^16",
    "express": "^4",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "puppeteer-core": "^24.42.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "puppeteer": "^24.42.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
