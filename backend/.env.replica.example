# Source Supabase project (the one you are copying FROM).
# Copy to backend/.env.replica — file is gitignored.
#
# Used by:
#   scripts/replicate-supabase.ps1  (via SOURCE_DATABASE_URL in shell, not this file)
#   scripts/sync-supabase-storage.mjs
#   npm run migrate:data (legacy row copy — partial, not full replica)

SOURCE_SUPABASE_URL=https://your-source-project.supabase.co
SOURCE_SUPABASE_SERVICE_ROLE_KEY=

# Optional aliases (migrate-supabase-data.mjs)
SOURCE_AI_MANAGER_SUPABASE_URL=https://your-source-project.supabase.co
SOURCE_AI_MANAGER_SUPABASE_SERVICE_ROLE_KEY=
